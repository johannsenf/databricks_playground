{
  "datasets": [
    {
      "name": "ds_wetter",
      "displayName": "Wetter Europa (Tage)",
      "queryLines": [
        "SELECT 'Historie' AS datenart, date AS datum, CASE city_name WHEN 'berlin' THEN 'Berlin' WHEN 'madrid' THEN 'Madrid' WHEN 'paris' THEN 'Paris' WHEN 'london' THEN 'London' WHEN 'athens' THEN 'Athen' WHEN 'reykjavik' THEN 'Reykjavík' WHEN 'amsterdam' THEN 'Amsterdam' WHEN 'belgrade' THEN 'Belgrad' WHEN 'moscow' THEN 'Moskau' WHEN 'stockholm' THEN 'Stockholm' WHEN 'istanbul' THEN 'Istanbul' END AS stadt, CASE country_code WHEN 'de' THEN 'Deutschland' WHEN 'es' THEN 'Spanien' WHEN 'fr' THEN 'Frankreich' WHEN 'gb' THEN 'Vereinigtes Königreich' WHEN 'gr' THEN 'Griechenland' WHEN 'is' THEN 'Island' WHEN 'nl' THEN 'Niederlande' WHEN 'rs' THEN 'Serbien' WHEN 'ru' THEN 'Russland' WHEN 'se' THEN 'Schweden' WHEN 'tr' THEN 'Türkei' END AS land,\n",
        "  latitude, longitude,\n",
        "  ROUND(temperature_min, 1) AS temp_min_c, ROUND(temperature_max, 1) AS temp_max_c,\n",
        "  ROUND(temperature_avg, 1) AS temp_avg_c, ROUND(temperature_realfeel_avg, 1) AS gefuehlt_avg_c,\n",
        "  ROUND(precipitation_lwe_total, 1) AS niederschlag_mm, ROUND(COALESCE(snow_lwe_total, 0), 1) AS schnee_mm,\n",
        "  CASE lower(precipitation_type_desc_predominant) WHEN 'rain' THEN 'Regen' WHEN 'snow' THEN 'Schnee' WHEN 'ice' THEN 'Eis' WHEN 'mixed' THEN 'Gemischt' ELSE 'kein' END AS niederschlag_typ,\n",
        "  CAST(NULL AS DOUBLE) AS niederschlag_wahrsch,\n",
        "  ROUND(wind_speed_avg * 3.6, 1) AS wind_avg_kmh, ROUND(wind_gust_max * 3.6, 1) AS boe_max_kmh,\n",
        "  ROUND(wind_direction_avg, 0) AS windrichtung_grad,\n",
        "  ROUND(humidity_relative_avg, 0) AS luftfeuchte_pct, cloud_cover_perc_avg AS bewoelkung_pct,\n",
        "  ROUND(index_uv_max, 1) AS uv_max, ROUND(minutes_of_sun_total / 60.0, 1) AS sonnenstunden,\n",
        "  ROUND(pressure_msl_avg / 100.0, 1) AS luftdruck_hpa\n",
        "FROM historical_daily_calendar_metric\n",
        "WHERE country_code IN ('de','es','fr','gb','gr','is','nl','rs','ru','se','tr') AND date < (SELECT MIN(date) FROM forecast_daily_calendar_metric)\n",
        "UNION ALL\n",
        "SELECT 'Prognose' AS datenart, date AS datum, CASE city_name WHEN 'berlin' THEN 'Berlin' WHEN 'madrid' THEN 'Madrid' WHEN 'paris' THEN 'Paris' WHEN 'london' THEN 'London' WHEN 'athens' THEN 'Athen' WHEN 'reykjavik' THEN 'Reykjavík' WHEN 'amsterdam' THEN 'Amsterdam' WHEN 'belgrade' THEN 'Belgrad' WHEN 'moscow' THEN 'Moskau' WHEN 'stockholm' THEN 'Stockholm' WHEN 'istanbul' THEN 'Istanbul' END AS stadt, CASE country_code WHEN 'de' THEN 'Deutschland' WHEN 'es' THEN 'Spanien' WHEN 'fr' THEN 'Frankreich' WHEN 'gb' THEN 'Vereinigtes Königreich' WHEN 'gr' THEN 'Griechenland' WHEN 'is' THEN 'Island' WHEN 'nl' THEN 'Niederlande' WHEN 'rs' THEN 'Serbien' WHEN 'ru' THEN 'Russland' WHEN 'se' THEN 'Schweden' WHEN 'tr' THEN 'Türkei' END AS land,\n",
        "  latitude, longitude,\n",
        "  ROUND(temperature_min, 1) AS temp_min_c, ROUND(temperature_max, 1) AS temp_max_c,\n",
        "  ROUND(temperature_avg, 1) AS temp_avg_c, ROUND(temperature_realfeel_avg, 1) AS gefuehlt_avg_c,\n",
        "  ROUND(precipitation_lwe_total, 1) AS niederschlag_mm, ROUND(COALESCE(snow_lwe_total, 0), 1) AS schnee_mm,\n",
        "  CASE lower(precipitation_type_desc_predominant) WHEN 'rain' THEN 'Regen' WHEN 'snow' THEN 'Schnee' WHEN 'ice' THEN 'Eis' WHEN 'mixed' THEN 'Gemischt' ELSE 'kein' END AS niederschlag_typ,\n",
        "  precipitation_probability / 100.0 AS niederschlag_wahrsch,\n",
        "  ROUND(wind_speed_avg * 3.6, 1) AS wind_avg_kmh, ROUND(wind_gust_max * 3.6, 1) AS boe_max_kmh,\n",
        "  ROUND(wind_direction_avg, 0) AS windrichtung_grad,\n",
        "  ROUND(humidity_relative_avg, 0) AS luftfeuchte_pct, cloud_cover_perc_avg AS bewoelkung_pct,\n",
        "  ROUND(index_uv_max, 1) AS uv_max, ROUND(minutes_of_sun_total / 60.0, 1) AS sonnenstunden,\n",
        "  CAST(NULL AS DOUBLE) AS luftdruck_hpa\n",
        "FROM forecast_daily_calendar_metric\n",
        "WHERE country_code IN ('de','es','fr','gb','gr','is','nl','rs','ru','se','tr') \n"
      ]
    },
    {
