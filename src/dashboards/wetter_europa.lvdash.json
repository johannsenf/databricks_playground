        "  latitude, longitude,\n",
        "  ROUND(temperature_min, 1) AS temp_min_c, ROUND(temperature_max, 1) AS temp_max_c,\n",
        "  ROUND(temperature_avg, 1) AS temp_avg_c,\n",
        "  ROUND(precipitation_lwe_total, 1) AS niederschlag_mm,\n",
        "  CASE lower(precipitation_type_desc_predominant) WHEN 'rain' THEN 'Regen' WHEN 'snow' THEN 'Schnee' WHEN 'ice' THEN 'Eis' WHEN 'mixed' THEN 'Gemischt' ELSE 'ohne' END AS niederschlag_art,\n",
        "  precipitation_probability / 100.0 AS niederschlag_wahrsch,\n",
        "  ROUND(wind_speed_avg * 3.6, 1) AS wind_avg_kmh, ROUND(wind_gust_max * 3.6, 1) AS boe_max_kmh,\n",
        "  ROUND(humidity_relative_avg, 0) AS luftfeuchte_pct,\n",
        "  ROUND(index_uv_max, 1) AS uv_max, ROUND(minutes_of_sun_total / 60.0, 1) AS sonnenstunden,\n",
        "  CAST(NULL AS DOUBLE) AS luftdruck_hpa\n",
