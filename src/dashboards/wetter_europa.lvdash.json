{
  "datasets": [
    {
      "name": "ds_wetter",
      "displayName": "Wetter Europa (Tage)",
      "queryLines": [
        "SELECT 'Ist' AS wertart, date AS datum, CASE city_name WHEN 'berlin' THEN 'Berlin' WHEN 'madrid' THEN 'Madrid' WHEN 'paris' THEN 'Paris' WHEN 'london' THEN 'London' WHEN 'athens' THEN 'Athen' WHEN 'reykjavik' THEN 'Reykjavík' WHEN 'amsterdam' THEN 'Amsterdam' WHEN 'belgrade' THEN 'Belgrad' WHEN 'moscow' THEN 'Moskau' WHEN 'stockholm' THEN 'Stockholm' WHEN 'istanbul' THEN 'Istanbul' END AS stadt, CASE country_code WHEN 'de' THEN 'Deutschland' WHEN 'es' THEN 'Spanien' WHEN 'fr' THEN 'Frankreich' WHEN 'gb' THEN 'Vereinigtes Königreich' WHEN 'gr' THEN 'Griechenland' WHEN 'is' THEN 'Island' WHEN 'nl' THEN 'Niederlande' WHEN 'rs' THEN 'Serbien' WHEN 'ru' THEN 'Russland' WHEN 'se' THEN 'Schweden' WHEN 'tr' THEN 'Türkei' END AS land,\n",
        "  latitude, longitude,\n",
        "  ROUND(temperature_min, 1) AS temp_min_c, ROUND(temperature_max, 1) AS temp_max_c,\n",
        "  ROUND(temperature_avg, 1) AS temp_avg_c,\n",
        "  ROUND(precipitation_lwe_total, 1) AS niederschlag_mm,\n",
        "  CASE lower(precipitation_type_desc_predominant) WHEN 'rain' THEN 'Regen' WHEN 'snow' THEN 'Schnee' WHEN 'ice' THEN 'Eis' WHEN 'mixed' THEN 'Gemischt' ELSE 'ohne' END AS niederschlag_art,\n",
        "  CAST(NULL AS DOUBLE) AS niederschlag_wahrsch,\n",
        "  ROUND(wind_speed_avg * 3.6, 1) AS wind_avg_kmh, ROUND(wind_gust_max * 3.6, 1) AS boe_max_kmh,\n",
        "  ROUND(humidity_relative_avg, 0) AS luftfeuchte_pct,\n",
        "  ROUND(index_uv_max, 1) AS uv_max, ROUND(minutes_of_sun_total / 60.0, 1) AS sonnenstunden,\n",
        "  ROUND(pressure_msl_avg / 100.0, 1) AS luftdruck_hpa\n",
        "FROM historical_daily_calendar_metric\n",
        "WHERE country_code IN ('de','es','fr','gb','gr','is','nl','rs','ru','se','tr') AND date < (SELECT MIN(date) FROM forecast_daily_calendar_metric)\n",
        "UNION ALL\n",
        "SELECT 'Prognose' AS wertart, date AS datum, CASE city_name WHEN 'berlin' THEN 'Berlin' WHEN 'madrid' THEN 'Madrid' WHEN 'paris' THEN 'Paris' WHEN 'london' THEN 'London' WHEN 'athens' THEN 'Athen' WHEN 'reykjavik' THEN 'Reykjavík' WHEN 'amsterdam' THEN 'Amsterdam' WHEN 'belgrade' THEN 'Belgrad' WHEN 'moscow' THEN 'Moskau' WHEN 'stockholm' THEN 'Stockholm' WHEN 'istanbul' THEN 'Istanbul' END AS stadt, CASE country_code WHEN 'de' THEN 'Deutschland' WHEN 'es' THEN 'Spanien' WHEN 'fr' THEN 'Frankreich' WHEN 'gb' THEN 'Vereinigtes Königreich' WHEN 'gr' THEN 'Griechenland' WHEN 'is' THEN 'Island' WHEN 'nl' THEN 'Niederlande' WHEN 'rs' THEN 'Serbien' WHEN 'ru' THEN 'Russland' WHEN 'se' THEN 'Schweden' WHEN 'tr' THEN 'Türkei' END AS land,\n",
        "  latitude, longitude,\n",
        "  ROUND(temperature_min, 1) AS temp_min_c, ROUND(temperature_max, 1) AS temp_max_c,\n",
        "  ROUND(temperature_avg, 1) AS temp_avg_c,\n",
        "  ROUND(precipitation_lwe_total, 1) AS niederschlag_mm,\n",
        "  CASE lower(precipitation_type_desc_predominant) WHEN 'rain' THEN 'Regen' WHEN 'snow' THEN 'Schnee' WHEN 'ice' THEN 'Eis' WHEN 'mixed' THEN 'Gemischt' ELSE 'ohne' END AS niederschlag_art,\n",
        "  precipitation_probability / 100.0 AS niederschlag_wahrsch,\n",
        "  ROUND(wind_speed_avg * 3.6, 1) AS wind_avg_kmh, ROUND(wind_gust_max * 3.6, 1) AS boe_max_kmh,\n",
        "  ROUND(humidity_relative_avg, 0) AS luftfeuchte_pct,\n",
        "  ROUND(index_uv_max, 1) AS uv_max, ROUND(minutes_of_sun_total / 60.0, 1) AS sonnenstunden,\n",
        "  CAST(NULL AS DOUBLE) AS luftdruck_hpa\n",
        "FROM forecast_daily_calendar_metric\n",
        "WHERE country_code IN ('de','es','fr','gb','gr','is','nl','rs','ru','se','tr') \n"
      ]
    },
